<view class="container">
  <view class="card">
    <text class="title">个人信息</text>
    <button class="login-button" bindtap="login" loading="{{isSubmitting}}" disabled="{{isSubmitting}}">微信快捷登录</button>
    <text class="status">{{status}}</text>
  </view>
  <view wx:if="{{profile}}" class="profile-result">
    <image wx:if="{{profile.avatar_url}}" class="result-avatar" src="{{profile.avatar_url}}" mode="aspectFill" />
    <text>{{profile.nickname || "微信用户"}}</text>
  </view>
</view>
