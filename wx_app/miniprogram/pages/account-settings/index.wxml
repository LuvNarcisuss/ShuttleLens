<scroll-view class="page" scroll-y>
  <view class="settings-intro">
    <text class="settings-title">账号设置</text>
    <text class="settings-subtitle">管理登录方式与账户安全</text>
  </view>

  <view class="settings-card">
    <view class="settings-row">
      <text class="settings-label">账号 ID</text>
      <text class="settings-value account-value">{{accountId}}</text>
    </view>
    <view class="settings-row">
      <text class="settings-label">手机</text>
      <text class="settings-value">{{maskedPhone || '未绑定'}}</text>
      <button class="row-action" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{isLoading}}" disabled="{{isLoading}}">{{maskedPhone ? '更换' : '关联'}}</button>
      <button wx:if="{{maskedPhone}}" class="row-action row-action-danger" bindtap="onPhoneAction" loading="{{isLoading}}" disabled="{{isLoading}}">解绑</button>
    </view>
    <view class="settings-row">
      <text class="settings-label">微信</text>
      <text class="settings-value">{{wechatStatus}}</text>
      <button class="row-action" bindtap="onWechatAction" loading="{{isLoading}}" disabled="{{isLoading}}">{{wechatBound ? '解绑' : '重新绑定'}}</button>
    </view>
    <view class="settings-row settings-row-last">
      <text class="settings-label">密码</text>
      <text class="settings-value">{{passwordSet ? '已设置' : '未设置'}}</text>
      <button class="row-action" bindtap="onPasswordAction" loading="{{isLoading}}" disabled="{{isLoading}}">{{passwordSet ? '重置' : '设置'}}</button>
    </view>
  </view>

  <view wx:if="{{isLoading || errorMessage}}" class="settings-feedback">
    <text wx:if="{{isLoading}}">账号信息加载中…</text>
    <text wx:if="{{errorMessage}}" class="settings-error">{{errorMessage}}</text>
  </view>

  <view class="settings-actions">
    <button class="settings-action identity-action" bindtap="onSwitchAccount" disabled="{{isLoading}}">切换账号</button>
    <button class="settings-action logout-action" bindtap="confirmLogout" disabled="{{isLoading}}">退出登录</button>
    <button class="settings-action cancel-action" bindtap="onDeactivate" disabled="{{isLoading}}">账号注销</button>
  </view>

  <view wx:if="{{showPasswordModal}}" class="password-modal-mask" bindtap="closePasswordModal">
    <view class="password-modal" catchtap="preventClose">
      <text class="password-modal-title">{{passwordSet ? '重置密码' : '设置密码'}}</text>
      <input
        class="password-input"
        password
        value="{{newPassword}}"
        bindinput="onNewPasswordInput"
        placeholder="请输入至少8位密码"
        maxlength="64"
      />
      <input
        class="password-input"
        password
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
        placeholder="请再次输入密码"
        maxlength="64"
      />
      <view class="password-modal-actions">
        <button class="password-modal-button password-cancel" bindtap="closePasswordModal">取消</button>
        <button class="password-modal-button password-confirm" bindtap="confirmSetPassword" loading="{{isLoading}}" disabled="{{isLoading}}">确认</button>
      </view>
    </view>
  </view>
</scroll-view>
