page {
  background: var(--brand-bg);
  color: var(--brand-text);
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  background: var(--brand-bg);
}

.settings-intro { padding: 16rpx 8rpx 30rpx; }
.settings-title, .settings-subtitle { display: block; }
.settings-title { color: var(--brand-text); font-size: 40rpx; font-weight: 700; }
.settings-subtitle { margin-top: 12rpx; color: var(--brand-muted); font-size: 25rpx; line-height: 40rpx; }
.settings-card { overflow: hidden; border: 1rpx solid var(--brand-divider); border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(35, 72, 120, .08); }
.settings-row { display: flex; align-items: center; min-height: 112rpx; padding: 0 24rpx; border-bottom: 1rpx solid var(--brand-divider); gap: 16rpx; }
.settings-row-last { border-bottom: 0; }
.settings-label { width: 150rpx; color: var(--brand-text); font-size: 27rpx; font-weight: 600; }
.settings-value { flex: 1; min-width: 0; color: var(--brand-muted); font-size: 25rpx; word-break: break-all; }
.account-value { color: var(--brand-text); }
.row-action, .settings-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; }
.row-action { flex: 0 0 auto; min-width: 88rpx; margin: 0; padding: 0 20rpx; border-radius: 12rpx; background: #EAF4FF; color: var(--brand-primary-strong); font-size: 23rpx; line-height: 1.2; }
.row-action::after, .settings-action::after { border: 0; }
.unavailable { background: #F2F4F7; color: var(--brand-muted); }
.settings-feedback { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 14rpx; background: #FFF7E8; color: #9A6700; font-size: 24rpx; line-height: 1.6; }
.settings-error { display: block; color: var(--brand-danger); }
.settings-actions { margin-top: 32rpx; }
.settings-action { width: 100%; margin-top: 20rpx; border-radius: 999rpx; background: var(--brand-primary); color: #FFFFFF; font-weight: 600; }
.settings-action:first-child { margin-top: 0; }
.settings-action[disabled] { opacity: .48; }
.logout-action { border: 2rpx solid var(--brand-danger); background: #FFFFFF; color: var(--brand-danger); }
.cancel-action { border: 2rpx solid var(--brand-danger); background: #FFF4F4; color: var(--brand-danger); }
