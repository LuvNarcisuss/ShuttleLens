page {
  background: var(--brand-bg);
  color: var(--brand-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 28rpx calc(44rpx + env(safe-area-inset-bottom)); }
.profile-edit-header { padding: 16rpx 8rpx 30rpx; }
.heading { display: block; font-size: 40rpx; font-weight: 700; }
.hint { display: block; margin-top: 12rpx; color: var(--brand-muted); font-size: 25rpx; line-height: 40rpx; }
.profile-form-card { overflow: hidden; margin-top: 20rpx; padding: 0; border: 1rpx solid var(--brand-divider); border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(35, 72, 120, .08); }
.profile-form-divider { height: 1rpx; background: var(--brand-divider); }
.profile-form-row { display: flex; min-height: 112rpx; box-sizing: border-box; align-items: center; justify-content: space-between; gap: 16rpx; padding: 0 24rpx; }
.profile-avatar-row { min-height: 176rpx; }
.profile-nickname-row { padding: 0 24rpx; }
.label { display: block; flex: 0 0 150rpx; width: 150rpx; color: var(--brand-text); font-size: 27rpx; font-weight: 600; }
.avatar-button { flex: 0 0 auto; width: 128rpx; height: 128rpx; margin: 0; padding: 0; overflow: hidden; border-radius: 64rpx; background: #EAF4FF; color: var(--brand-primary-strong); font-size: 22rpx; }
.avatar-button::after, .primary::after { border: 0; }
.avatar { width: 100%; height: 100%; }
.avatar-placeholder { line-height: 128rpx; }
.nickname { flex: 1; min-width: 0; height: 96rpx; box-sizing: border-box; margin: 0; padding: 0 22rpx; border: 1rpx solid var(--brand-divider); border-radius: 14rpx; background: #FFFFFF; color: var(--brand-text); font-size: 27rpx; }
.primary { margin-top: 32rpx; border-radius: 999rpx; background: var(--brand-primary); color: #FFFFFF; font-weight: 600; }
.profile-form-feedback { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 14rpx; background: #FFF7E8; }
.form-busy, .form-error { display: block; font-size: 24rpx; line-height: 1.6; }
.form-busy { color: #9A6700; }
.form-error { color: var(--brand-danger); }
.primary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; line-height: 1.2; }
