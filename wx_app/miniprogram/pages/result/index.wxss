.page { min-height: 100vh; background: var(--brand-bg); color: var(--brand-text); }
.result-hero { padding: 58rpx 34rpx 38rpx; background: linear-gradient(135deg, var(--brand-primary), var(--brand-primary-strong)); color: #FFFFFF; }
.eyebrow { display: block; color: #D9ECFF; font-size: 20rpx; letter-spacing: 4rpx; }
.title { display: block; margin-top: 10rpx; font-size: 46rpx; font-weight: 760; }
.task-id { display: block; margin-top: 12rpx; color: #EAF4FF; font-size: 23rpx; }
.result-state-card, .result-card { margin: 24rpx; padding: 30rpx; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(35, 72, 120, .10); }
.result-state-card { display: flex; flex-direction: column; gap: 20rpx; color: var(--brand-muted); text-align: center; }
.result-state-card.error, .resource-error { color: var(--brand-danger); }
.card-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; color: var(--brand-text); font-size: 30rpx; font-weight: 700; }
.fullscreen { margin: 0; padding: 0 22rpx; border-radius: 12rpx; background: var(--brand-primary); color: #FFFFFF; font-size: 23rpx; font-weight: 650; line-height: 62rpx; }
.fullscreen::after { border: 0; }
.video { width: 100%; border-radius: 14rpx; background: #000; }
.image-list { display: flex; flex-direction: column; gap: 20rpx; }
.chart-item { padding-bottom: 22rpx; border-bottom: 1rpx solid var(--brand-divider); }
.chart { width: 100%; border-radius: 14rpx; background: #EAF4FF; }
.save-button, .settings-button { margin-top: 22rpx; border-radius: 12rpx; background: var(--brand-primary); color: #FFFFFF; font-size: 26rpx; font-weight: 650; }
.save-button.secondary { background: #EAF4FF; color: var(--brand-primary-strong); }
.save-button::after, .settings-button::after { border: 0; }
.save-button[disabled] { background: #D7DEE8; color: var(--brand-muted); }
.permission-card { margin: 20rpx 24rpx 40rpx; padding: 26rpx; border-radius: 18rpx; background: #FDEBEC; color: var(--brand-danger); font-size: 25rpx; }
.settings-button { margin-top: 18rpx; }
.empty { display: block; padding: 50rpx 0; color: var(--brand-muted); text-align: center; }
.resource-error { display: block; margin: 20rpx 24rpx 40rpx; font-size: 25rpx; }
.legacy-note { margin: 24rpx; padding: 22rpx; border-radius: 16rpx; background: #EAF4FF; color: var(--brand-primary-strong); font-size: 24rpx; line-height: 1.6; }
.confidence { padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(18, 183, 106, .12); color: var(--brand-success); font-size: 21rpx; font-weight: 600; }
.quality-note { display: block; margin: -10rpx 0 22rpx; color: var(--brand-muted); font-size: 23rpx; line-height: 1.6; }
.scope-tabs { display: grid; grid-template-columns: repeat(3, 1fr); padding: 6rpx; border-radius: 14rpx; background: #F1F3F6; }
.scope-tab { padding: 16rpx; border-radius: 10rpx; color: var(--brand-muted); font-size: 25rpx; text-align: center; }
.scope-tab.active { background: #FFFFFF; box-shadow: 0 3rpx 10rpx rgba(35, 72, 120, .10); color: var(--brand-primary-strong); font-weight: 700; }
.player-switch { display: flex; gap: 16rpx; margin-top: 20rpx; }
.player-switch text { flex: 1; padding: 16rpx; border: 2rpx solid var(--brand-divider); border-radius: 12rpx; color: var(--brand-muted); font-size: 23rpx; text-align: center; }
.player-switch text.selected { border-color: var(--brand-primary); background: #EAF4FF; color: var(--brand-primary-strong); }
.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-top: 22rpx; }
.metric-card { min-height: 150rpx; padding: 20rpx; border: 1rpx solid var(--brand-divider); border-radius: 14rpx; background: #FFFFFF; }
.metric-label, .metric-meta, .metric-reason { display: block; }
.metric-label { color: var(--brand-muted); font-size: 23rpx; }
.metric-value { font-size: 40rpx; font-weight: 700; }
.metric-unit { margin-left: 7rpx; color: var(--brand-muted); font-size: 21rpx; }
.metric-meta, .metric-reason { margin-top: 8rpx; color: var(--brand-muted); font-size: 18rpx; word-break: break-all; }
.timeline { margin-top: 24rpx; white-space: nowrap; }
.timeline-row { display: inline-flex; gap: 12rpx; padding-bottom: 8rpx; }
.rally-chip { display: flex; flex-direction: column; gap: 6rpx; min-width: 150rpx; padding: 16rpx; border: 2rpx solid var(--brand-divider); border-radius: 12rpx; color: var(--brand-muted); font-size: 21rpx; }
.rally-chip.selected { border-color: var(--brand-primary); background: #EAF4FF; color: var(--brand-primary-strong); }
.highlight-item { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--brand-divider); }
.highlight-main { display: flex; flex: 1; flex-direction: column; gap: 7rpx; color: var(--brand-muted); font-size: 22rpx; }
.highlight-title { color: var(--brand-text); font-size: 27rpx; font-weight: 700; }
.edit-button { width: 110rpx; margin: 0; padding: 0; border-radius: 10rpx; background: #EAF4FF; color: var(--brand-primary-strong); font-size: 23rpx; font-weight: 650; line-height: 64rpx; }
.edit-button::after { border: 0; }
.highlight-actions { display: flex; flex-direction: column; gap: 10rpx; }
.edit-button.save-clip { width: 132rpx; background: var(--brand-success); color: #FFFFFF; }
.share-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: var(--brand-muted); font-size: 22rpx; }
.share-card view { display: flex; flex: 1; flex-direction: column; gap: 8rpx; }
.share-button { width: 140rpx; }
.editor-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(29, 38, 51, .45); }
.result-sheet { box-sizing: border-box; width: 100%; padding: 34rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #FFFFFF; }
.editor-title { display: block; margin-bottom: 24rpx; font-size: 32rpx; font-weight: 700; }
.editor-time { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.editor-field { margin-top: 18rpx; color: var(--brand-muted); font-size: 23rpx; }
.editor-field input { margin-top: 10rpx; padding: 18rpx; border: 1rpx solid var(--brand-divider); border-radius: 12rpx; background: #F5F7FA; color: var(--brand-text); }
.editor-field.inline { display: flex; align-items: center; justify-content: space-between; }
.restore { display: block; margin-top: 22rpx; color: var(--brand-primary-strong); font-size: 24rpx; }
.editor-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.editor-actions button { flex: 1; margin: 0; }
.editor-actions .secondary { background: #F1F3F6; color: var(--brand-muted); }
