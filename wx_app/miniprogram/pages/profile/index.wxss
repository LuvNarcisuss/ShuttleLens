page {
  background: var(--brand-bg);
  color: var(--brand-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page { height: 100vh; box-sizing: border-box; padding: 24rpx; }
.profile-hero { display: flex; align-items: center; gap: 22rpx; padding: 36rpx 30rpx; border-radius: 28rpx; background: linear-gradient(135deg, var(--brand-primary-strong), var(--brand-primary)); color: #FFFFFF; box-shadow: 0 16rpx 38rpx rgba(22, 136, 255, .22); }
.avatar-shell { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; overflow: hidden; border: 4rpx solid rgba(255, 255, 255, .72); border-radius: 54rpx; background: #EAF4FF; }
.avatar { width: 100%; height: 100%; }
.avatar-fallback { color: var(--brand-primary-strong); font-size: 42rpx; font-weight: 700; }
.identity { display: flex; flex: 1; flex-direction: column; gap: 8rpx; min-width: 0; }
.name { overflow: hidden; font-size: 34rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.status { color: rgba(255, 255, 255, .76); font-size: 23rpx; }
.status.online { color: #D9FDEB; }
.phone { color: rgba(255, 255, 255, .88); font-size: 23rpx; letter-spacing: 1rpx; }
.login { flex: 0 0 auto; margin: 0; padding: 0 20rpx; border-radius: 12rpx; background: #FFFFFF; color: var(--brand-primary-strong); font-size: 23rpx; line-height: 68rpx; }
.login::after, .preview::after, .profile-edit-action::after, .profile-danger-action::after { border: 0; }

.profile-section { margin-top: 22rpx; padding: 30rpx; border: 1rpx solid var(--brand-divider); border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(35, 72, 120, .08); }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; font-size: 31rpx; font-weight: 650; }
.count, .section-caption { color: var(--brand-muted); font-size: 23rpx; font-weight: 400; }
.section-caption { text-align: right; }
.empty { padding: 80rpx 0; color: var(--brand-muted); font-size: 26rpx; text-align: center; }
.task-list { display: flex; flex-direction: column; gap: 18rpx; }
.task { padding: 24rpx; border: 1rpx solid var(--brand-divider); border-radius: 16rpx; background: #FFFFFF; }
.task-top, .task-bottom, .progress-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.task-id { flex: 1; overflow: hidden; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.badge { padding: 6rpx 14rpx; border-radius: 18rpx; background: #EEF2F6; color: var(--brand-muted); font-size: 20rpx; }
.status-succeeded { background: #E6F8EF; color: var(--brand-success); }
.status-failed { background: #FFF0F0; color: var(--brand-danger); }
.progress-row { margin: 20rpx 0; color: var(--brand-muted); font-size: 22rpx; }
.progress { flex: 1; }
.task-bottom { color: var(--brand-muted); font-size: 22rpx; }
.preview { margin: 0; padding: 0 18rpx; border-radius: 10rpx; background: #EAF4FF; color: var(--brand-primary-strong); font-size: 22rpx; line-height: 56rpx; }
.error { display: block; margin-top: 22rpx; color: var(--brand-danger); font-size: 24rpx; line-height: 1.6; }
.profile-account-section { padding-bottom: 26rpx; }
.profile-security-section { margin-bottom: 8rpx; }
.profile-edit-action, .profile-danger-action { width: 100%; margin: 0; border-radius: 14rpx; font-size: 25rpx; line-height: 76rpx; }
.profile-edit-action { background: #EAF4FF; color: var(--brand-primary-strong); }
.profile-danger-action { background: #FFF0F0; color: var(--brand-danger); }
